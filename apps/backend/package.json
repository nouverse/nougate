{
  "name": "@nouverse/nougate-backend",
  "description": "Nougate backend \u2014 modular LLM router with multi-provider auth isolation and multi-protocol support.",
  "version": "0.7.0",
  "private": true,
  "module": "src/server.ts",
  "bin": {
    "nougate": "./src/server.ts"
  },
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun run --watch src/server.ts",
    "lint:check": "bun x tsc --noEmit --skipLibCheck",
    "test": "bun test tests/unit",
    "test:functional": "bun test tests/functional",
    "reset-accounts": "bun run src/scripts/reset-accounts.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun": "1.4.2",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./src/boot.ts"
  }
}
