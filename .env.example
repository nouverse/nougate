# Nougate Gateway Configuration
#
# Copy to .env. Under Docker Compose every key here is passed into the
# container via `env_file`, so adding a variable to .env is enough — you do not
# also have to list it under `environment:` in the compose file.
#
# Two values are pinned by the compose files and ignored from .env:
#   HEADROOM_URL — must point at the `headroom` service, not localhost
#   BASE_URL     — pinned in docker-compose.prod.yml so a dev .env cannot
#                  silently downgrade production to http://localhost

# Port that the Bun API backend will listen on (default: 3000)
PORT=3000

# Base URL of the gateway used for provider OAuth callback redirects (default: http://localhost:3000)
# Make sure to update this if hosting behind a reverse proxy (e.g., https://nougate.nouverse.tech)
BASE_URL=http://localhost:3000

# Optional: Override the backend URL target for Vite local dev server proxy (default: value of BASE_URL or http://localhost:3000)
# VITE_BACKEND_URL=http://localhost:3000

# ─── Dashboard authentication ─────────────────────────────────────────────────
# The dashboard and /api/* are ALWAYS protected by username + password. Accounts
# live in the SQLite database, not in a file.
#
# On first run an "admin" account is created with the password "admin123". It is
# flagged for mandatory replacement, so it only ever unlocks the change-password
# screen — nothing else works until you set a real password.
#
# The LLM proxy routes (/openai/v1/*, /anthropic/v1/*) are NOT covered by this;
# they are guarded separately by gateway API keys (see apiKeys in config.json).

# Optional. Signs the session cookie. If unset, one is generated and stored at
# data/.session-secret, so you do not need to set this. Changing it signs
# everyone out.
# SESSION_SECRET=

# Optional. How long a session cookie stays valid (default: 168 hours = 7 days).
# SESSION_TTL_HOURS=168

# ─── Database ─────────────────────────────────────────────────────────────────
# Holds dashboard users, token usage, gateway API keys, and custom providers.
#
# Leave DB_URL empty to use the built-in SQLite file (no server required) —
# /app/data/nougate.db in Docker, ./data/nougate.db locally.
# Set it to a Postgres URL to use Postgres instead. Nothing else changes: the
# schema is created on first boot either way.
# DB_URL=postgres://user:password@localhost:5432/nougate

# Override the SQLite file location (ignored when DB_URL points at Postgres).
# NOUGATE_DB_PATH=./data/nougate.db

# Optional blanket rate for models that neither the dashboard nor the built-in
# price book can price. USD per 1M tokens. Off by default (0), which reports such
# models as "unpriced" at $0 instead of estimating them.
# DEFAULT_INPUT_PRICE_1M=0
# DEFAULT_OUTPUT_PRICE_1M=0

# ─── Token compression (optional) ─────────────────────────────────────────────
# External Headroom compression service. Leave unset to disable.
# HEADROOM_URL=http://headroom:8787

# ─── Pod limits (optional) ────────────────────────────────────────────────────
# Both are unset by default, and unset means NOT ENFORCED. Neither has a built-in
# value, so upgrading never silently changes how an existing deployment behaves.

# Minimum delay, in milliseconds, before ANY provider's request leaves the
# gateway. This is a floor, not a setting: it raises a provider's own jitter
# window and overrides a provider that turned jitter off entirely. A provider
# already asking for more than this keeps its own window.
# BOTTOM_JITTER_MS is accepted as an alias for the same thing.
# BOTTOM_JITTER=1500

# Cap on how many accounts a provider may rotate through — the top N of its own
# health ranking. Extra accounts are still stored and still take over when one of
# the top N gets sick or hits a cooldown; they just do not all rotate at once.
# MAX_ACCOUNT_MULTIPLEXING=5
