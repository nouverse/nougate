# Nougate Gateway Configuration

# Port that the Bun API backend will listen on (default: 3000)
PORT=3000

# Base URL of the gateway used for Google OAuth callback redirects (default: http://localhost:3000)
# Make sure to update this if hosting behind a reverse proxy (e.g., https://nougate.nouverse.tech)
BASE_URL=http://localhost:3000

# Optional: Override the backend URL target for Vite local dev server proxy (default: value of BASE_URL or http://localhost:3000)
# VITE_BACKEND_URL=http://localhost:3000

# ─── Metrics & state database ─────────────────────────────────────────────────
# SQLite file holding token usage, gateway API keys, and custom providers.
# Defaults to /app/data/nougate.db in Docker, otherwise ./data/nougate.db
# NOUGATE_DB_PATH=./data/nougate.db

# Cost fallback for models with no configured price and no price-book match.
# USD per 1M tokens. Only affects the estimate shown on the Token Metrics page.
# DEFAULT_INPUT_PRICE_1M=2.5
# DEFAULT_OUTPUT_PRICE_1M=10

# ─── Dashboard authentication (optional) ──────────────────────────────────────
# Guards the dashboard and the /api/* admin endpoints with Google sign-in.
# The LLM proxy routes (/v1/*) are NOT covered by this.
#
# The ONLY switch is "enabled" in data/auth.json — these variables just make the
# login flow work. If auth.json says enabled, the dashboard is closed no matter
# what is or isn't set here.
#
# Create a "Web application" OAuth client at https://console.cloud.google.com/apis/credentials
# and register this Authorized redirect URI: <BASE_URL>/api/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# Optional. Signs the session cookie. If unset, one is generated and stored next
# to auth.json, so you do not need to set this. Changing it signs everyone out.
# SESSION_SECRET=

# Optional: override where the email allowlist lives. By default the first of
# these that exists is used: /app/data/auth.json, ./data/auth.json, ./auth.json
# AUTH_FILE=./data/auth.json
