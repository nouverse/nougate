{
  "name": "@nouverse/nougate",
  "description": "Modular LLM router with multi-provider auth isolation and multi-protocol support.",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter @nouverse/nougate-backend dev",
    "dev:frontend": "npm run --prefix apps/frontend dev",
    "start": "bun run --filter @nouverse/nougate-backend start",
    "build:frontend": "npm run --prefix apps/frontend build",
    "lint:check": "bun run --filter @nouverse/nougate-backend lint:check",
    "test": "bun run --filter @nouverse/nougate-backend test",
    "test:functional": "bun run --filter @nouverse/nougate-backend test:functional",
    "test:frontend": "cd apps/frontend && bun test tests"
  }
}
