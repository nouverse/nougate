{
  "$schema": "./model-specs.schema.json",
  "_comment": "Model specifications for Antigravity Proxy. Edit this file to add/modify models without redeploying.",

  "claudeRegistry": [
    "claude-3-7-sonnet-20250219",
    "claude-3-5-sonnet-20241022",
    "claude-3-5-sonnet-v2-20241022",
    "claude-3-5-sonnet-20240620",
    "claude-3-5-haiku-20241022",
    "claude-3-opus-20240229",
    "claude-opus-4-6-thinking",
    "claude-sonnet-4-6",
    "claude-sonnet-4-6-thinking",
    "claude-3-sonnet-20240229",
    "claude-3-haiku-20240307"
  ],

  "nativelySupportedModels": [
    "claude-opus-4-6-thinking",
    "gemini-3.5-flash-low",
    "gemini-3.1-pro-high",
    "gemini-3.1-pro-low",
    "gemini-3.1-pro",
    "gemini-3.1-pro-preview",
    "gemini-3-flash",
    "gemini-3-pro-high",
    "gemini-3-pro-low",
    "gemini-3-pro",
    "gemini-2.5-pro",
    "gemini-2.5-flash",
    "gemini-2.5-flash-lite",
    "gemini-2.5-flash-thinking",
    "gemini-3-pro-preview",
    "gemini-3-flash-preview",
    "gpt-oss-120b",
    "gpt-oss-120b-medium"
  ],

  "forceThinkingAliases": {
    "_comment": "Models that must always be remapped to their -thinking variant",
    "claude-opus-4-6": "claude-opus-4-6-thinking",
    "claude-sonnet-4-6": "claude-sonnet-4-6-thinking",
    "claude-sonnet-4-5": "claude-sonnet-4-5-thinking",
    "antigravity-claude-opus-4-6": "claude-opus-4-6-thinking",
    "antigravity-claude-sonnet-4-6": "claude-sonnet-4-6-thinking",
    "antigravity-claude-sonnet-4-5": "claude-sonnet-4-5-thinking"
  },

  "gptFallbacks": {
    "_comment": "GPT model fallbacks for CLI pool (non gpt-oss)",
    "thinking": "gemini-2.0-flash-thinking-exp",
    "default": "gemini-2.0-pro-exp"
  },

  "sandboxTieredModels": {
    "_comment": "Models that get tier suffix in sandbox mode. Key = baseModel match, value = default tier if none specified",
    "gemini-3.5-flash": "high",
    "gemini-3.1-pro": "high",
    "gemini-3-pro": "high"
  },

  "sandboxPassthroughModels": [
    "gemini-3-flash",
    "gpt-oss"
  ],

  "thinkingBudgetDefaults": {
    "_comment": "Default thinking budgets by tier for -thinking models",
    "low": 8192,
    "medium": 16000,
    "high": 32768,
    "default": 16000
  },

  "thinkingConfig": {
    "_comment": "Models that get thinkingConfig with thinkingLevel (not thinkingBudget). These use tier-based levels instead of token budgets.",
    "thinkingLevelModels": [
      "gemini-3-pro",
      "gemini-3.1-pro",
      "gemini-3.5-flash"
    ],
    "defaultThinkingLevel": "low"
  },

  "maxOutputTokens": {
    "_comment": "Per-model max output token overrides. Falls back to 64000 for thinking models, 4096 for others.",
    "thinking": 64000,
    "default": 4096
  }
}
